---
import type { ReadonlyResumeData } from "../data/resume";
const { resume } = Astro.props as { resume: ReadonlyResumeData };

const categoryIcons: Record<string, string> = {
  backend:        "M22 12h-4l-3 9L9 3l-3 9H2",
  frontend:       "M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z",
  databases:      "M12 2C6.48 2 2 4.02 2 6.5v11C2 19.98 6.48 22 12 22s10-2.02 10-4.5v-11C22 4.02 17.52 2 12 2z M2 6.5C2 8.98 6.48 11 12 11s10-2.02 10-4.5",
  infrastructure: "M22 12H2 M5 12V7a7 7 0 0 1 14 0v5 M5 12v5a7 7 0 0 0 14 0v-5",
};
---

<section id="habilidades" class="card skills-section" aria-labelledby="skills-title">
  <div class="section-header">
    <span class="section-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
           stroke-linecap="round" stroke-linejoin="round">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
      </svg>
    </span>
    <h2 id="skills-title">Habilidades</h2>
  </div>

  <div class="skills-columns">
    {resume.skills.map((group) => (
      <div class="skills-col">
        <div class="skills-col-header">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={categoryIcons[group.id] ?? "M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"} />
          </svg>
          <span>{group.label}</span>
        </div>
        <div class="skill-tags">
          {group.items.map((skill) => (
            <span class="skill-tag">{skill}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
