---
import ThemeToggle from "./ThemeToggle.astro";

const navItems = [
  {
    href: "#inicio",
    label: "Inicio",
    d: "M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z M9 22V12h6v10",
  },
  {
    href: "#perfil",
    label: "Perfil",
    d: "M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2 M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z",
  },
  {
    href: "#experiencia",
    label: "Experiencia",
    d: "M22 7H2 M2 7l4-3h12l4 3 M2 7v13a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V7 M8 11h8",
  },
  {
    href: "#educacion",
    label: "Educacion",
    d: "M22 10v6M2 10l10-5 10 5-10 5-10-5z M6 12v5c3 3 9 3 12 0v-5",
  },
  {
    href: "#habilidades",
    label: "Habilidades",
    d: "M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z",
  },
  {
    href: "#contacto",
    label: "Contacto",
    d: "M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z M22 6l-10 7L2 6",
  },
] as const;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-logo" href="#inicio">{"{ JCC }"}</a>

    <nav class="site-nav" aria-label="Secciones principales">
      {navItems.map((item) => (
        <a class="site-nav__link" href={item.href}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={item.d} />
          </svg>
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <ThemeToggle />
      <a class="nav-download" href="/docs/HV-Jose-Castro.pdf" download aria-label="Descargar CV">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        <span>Descargar CV</span>
      </a>
    </div>
  </div>
</header>
