---
import type { ReadonlyResumeData } from "../data/resume";
const { resume } = Astro.props as { resume: ReadonlyResumeData };

const initials = resume.name
  .split(" ")
  .filter((_, i) => i < 3)
  .map((n) => n[0])
  .join("");

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const photoSrc = resume.photo ? `${base}${resume.photo}` : null;
---

<section id="perfil" class="card profile-section" aria-labelledby="perfil-title">
  <div class="section-header">
    <span class="section-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
           stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
        <circle cx="12" cy="7" r="4"/>
      </svg>
    </span>
    <h2 id="perfil-title">Perfil</h2>
  </div>

  <div class="profile-body">
    <!-- Avatar -->
    <div class="profile-avatar">
      {photoSrc
        ? <img src={photoSrc} alt={resume.name} />
        : <div class="avatar-placeholder">{initials}</div>
      }
    </div>

    <!-- Content -->
    <div class="profile-content">
      {resume.intro && <p class="profile-intro">{resume.intro}</p>}
      <ul class="profile-items">
        {resume.profile.map((item) => (
          <li class="profile-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
